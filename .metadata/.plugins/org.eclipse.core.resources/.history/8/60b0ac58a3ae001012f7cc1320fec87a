void SetAllRed() {
    HAL_GPIO_WritePin(TRAFFIC_PORT, SOUTH_RED_PIN, GPIO_PIN_SET);
    HAL_GPIO_WritePin(TRAFFIC_PORT, WEST_RED_PIN, GPIO_PIN_SET);
    HAL_GPIO_WritePin(TRAFFIC_PORT, NORTH_RED_PIN, GPIO_PIN_SET);
    HAL_GPIO_WritePin(TRAFFIC_PORT, EAST_RED_PIN, GPIO_PIN_SET);

    HAL_GPIO_WritePin(TRAFFIC_PORT, SOUTH_GREEN_PIN, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(TRAFFIC_PORT, WEST_GREEN_PIN, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(TRAFFIC_PORT, NORTH_GREEN_PIN, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(TRAFFIC_PORT, EAST_GREEN_PIN, GPIO_PIN_RESET);
}

void SetTrafficState(TrafficState state) {
    SetAllRed();  // first turn everything red

    switch (state) {
        case SOUTH_GREEN:
            HAL_GPIO_WritePin(TRAFFIC_PORT, SOUTH_RED_PIN, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(TRAFFIC_PORT, SOUTH_GREEN_PIN, GPIO_PIN_SET);
            break;
        case WEST_GREEN:
            HAL_GPIO_WritePin(TRAFFIC_PORT, WEST_RED_PIN, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(TRAFFIC_PORT, WEST_GREEN_PIN, GPIO_PIN_SET);
            break;
        case NORTH_GREEN:
            HAL_GPIO_WritePin(TRAFFIC_PORT, NORTH_RED_PIN, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(TRAFFIC_PORT, NORTH_GREEN_PIN, GPIO_PIN_SET);
            break;
        case EAST_GREEN:
            HAL_GPIO_WritePin(TRAFFIC_PORT, EAST_RED_PIN, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(TRAFFIC_PORT, EAST_GREEN_PIN, GPIO_PIN_SET);
            break;
    }
}


void set_status(Reader readby){
		prevState = trafficState;
	if(readby == reader1){
		trafficTimer = 0;
		emergencychange = true;
		SetTrafficState(SOUTH_GREEN);
	}
	else if(readby == reader2){
		trafficTimer = 0;
		emergencychange = true;
		SetTrafficState(WEST_GREEN);
	}
}

void ProcessRFIDCard(uint8_t *card_id)
{
    char msg[100];

    // Check Ambulance card
    if (card_id[2] == 174 && card_id[4] == 39)
    {
        sprintf(msg, "\r\n🚑 Ambulance detected!\r\nVehicle Number: KA20 G 9999\r\n");
        HAL_UART_Transmit(&huart2, (uint8_t *)msg, strlen(msg), HAL_MAX_DELAY);
    }
    // Check Police vehicle card
    else if (card_id[2] == 175 && card_id[4] == 118)
    {
        sprintf(msg, "\r\n🚓 Police vehicle detected!\r\nVehicle Number: KA20 G 1234\r\n");
        HAL_UART_Transmit(&huart2, (uint8_t *)msg, strlen(msg), HAL_MAX_DELAY);
    }
}

